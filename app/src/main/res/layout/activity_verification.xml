<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    tools:context=".VerificationActivity">

    <ImageView
        android:id="@+id/img_scanner_ab"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.3"
        android:scaleType="centerCrop"
        app:srcCompat="@drawable/avatars" />

    <RelativeLayout
        android:id="@+id/rl_container_ab"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.7"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_resume_ab"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Résumé du voyageur..."
            android:textSize="16sp" />

        <Button
            android:id="@+id/btn_approuver_ab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_resume_ab"
            android:layout_marginTop="20dp"
            android:text="Approuver" />

        <Button
            android:id="@+id/btn_refuser_ab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/btn_approuver_ab"
            android:layout_marginTop="10dp"
            android:text="Refuser" />

    </RelativeLayout>

</LinearLayout>