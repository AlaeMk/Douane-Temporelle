<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_result_ab"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#209247"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp"
    tools:context=".ResultActivity">

    <ImageView
        android:id="@+id/img_status_ab"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:scaleType="fitCenter"
        android:src="@drawable/bonvoyage" />

    <TextView
        android:id="@+id/tv_titre_ab"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="SUCCESS!"
        android:textAlignment="center"
        android:textColor="#FFFFFF"
        android:textSize="36sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_message_ab"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Message"
        android:textAlignment="center"
        android:textColor="#FFFFFF"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/tv_subtext_ab"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="Opération pour 'Douane Temporelle' réussie. Appuyez pour recommencer."
        android:textAlignment="center"
        android:textColor="#E0E0E0"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btn_nouveau_voyageur_ab"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:backgroundTint="#FFFFFF"
        android:text="NOUVEAU VOYAGEUR"
        android:textColor="#209247"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>